# Copy to .env (repo root) and adjust. Every value has a sensible default.

# Database: SQLite by default. For PostgreSQL + PostGIS (docker compose up db):
# DATABASE_URL=postgresql+psycopg2://resq:resq@localhost:5432/resqroute
# DATABASE_URL=

# Road network (default: data/network.json if you imported OSM, else the bundled demo)
# NETWORK_FILE=data/network.json

# Traffic engine: builtin (no install needed) or sumo (pip install -r backend/requirements-sumo.txt)
SIM_ENGINE=builtin
SUMO_GUI=false

# Live simulation
SIM_SPEED=3            # simulated seconds per real second
DEMAND=medium          # off | low | medium | high
SEED=42
PRIORITY_ENABLED=true
RECOVERY_ENABLED=true
QUEUE_SOURCE=sim       # sim | cv
SIM_AUTOSTART=true

# Protect the admin endpoints (simulation control, experiments). Empty = open (local demo only).
ADMIN_TOKEN=
